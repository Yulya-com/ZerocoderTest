# =====================================================================
#  Пример файла с переменными окружения для чат-бота "Алина"
#  Скопируйте этот файл в .env и заполните своими значениями.
#
#  ВАЖНО: файл .env содержит секреты и НЕ должен попадать в Git.
#         Реальные значения ключей и токенов добавляйте в .env вручную.
#         В этом файле (.env.example) реальных значений быть не должно.
# =====================================================================


# ---------------------------------------------------------------------
# ВКонтакте (сообщество)
# ---------------------------------------------------------------------
# Токен доступа сообщества (Community token) с правами на работу
# с сообщениями. Получить: Управление сообществом -> Работа с API ->
# Создать ключ доступа (включить права "Сообщения сообщества").
VK_GROUP_TOKEN=

# Числовой ID сообщества (только цифры, без ведущего минуса).
# Узнать: в адресе страницы сообщества или в его настройках.
VK_GROUP_ID=


# ---------------------------------------------------------------------
# GigaChat API
# ---------------------------------------------------------------------
# Ключ авторизации (Authorization Key) из личного кабинета GigaChat API
# (Studio). Это значение в формате Base64 от пары ClientID:ClientSecret.
# Именно его передаёт базовый HTTP-клиент в заголовке Authorization.
# Получить: проект GigaChat API -> Настройки API -> Получить ключ.
GIGACHAT_AUTH_KEY=

# Альтернативный способ: указать ClientID и ClientSecret по отдельности.
# Если GIGACHAT_AUTH_KEY не задан, ключ авторизации будет собран
# автоматически как Base64(ClientID:ClientSecret).
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=

# Область доступа (scope) к API. Возможные значения:
#   GIGACHAT_API_PERS  - доступ для физических лиц (по умолчанию)
#   GIGACHAT_API_B2B   - доступ для ИП и юрлиц по платным пакетам
#   GIGACHAT_API_CORP  - доступ для ИП и юрлиц по схеме pay-as-you-go
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Идентификатор модели. Доступные значения (см. документацию):
#   GigaChat-2 (по умолчанию), GigaChat-2-Pro, GigaChat-2-Max,
#   GigaChat-3-Ultra (Freemium для физлиц).
GIGACHAT_MODEL=GigaChat-2

# Базовый адрес API для запросов на генерацию.
GIGACHAT_BASE_URL=https://api.giga.chat/v1

# Адрес для получения токена доступа (POST /api/v2/oauth).
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

# Проверять SSL-сертификат сервера. Для GigaChat API нужен корневой
# сертификат Минцифры. Если он установлен в системе - оставьте true.
# Если сертификат не установлен и возникает ошибка
# CERTIFICATE_VERIFY_FAILED, укажите путь к файлу сертификата в
# GIGACHAT_CA_BUNDLE (предпочтительно) ИЛИ поставьте false (небезопасно,
# только для локальной отладки).
GIGACHAT_VERIFY_SSL=true

# Путь к файлу корневого сертификата Минцифры (PEM/CRT).
# Пример: C:\certs\russian_trusted_root_ca_pem.crt
GIGACHAT_CA_BUNDLE=

# Температура генерации (0..2). Оставьте пустым, чтобы использовать
# значение по умолчанию на стороне модели.
GIGACHAT_TEMPERATURE=


# ---------------------------------------------------------------------
# Настройки чат-бота
# ---------------------------------------------------------------------
# Ссылка на форму для связи с отделом продаж, которую Алина
# предлагает заполнить пользователю.
MANAGER_FORM_URL=https://zerocoder.ru/

# Максимальное количество пар "вопрос-ответ" в памяти диалога.
MAX_HISTORY_TURNS=10

# Уровень логирования: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
